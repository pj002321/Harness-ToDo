# secrets.example.env — 이 파일은 필요한 환경변수 키 목록입니다. 실제 값은 절대 여기에 넣지 마세요. .env로 복사해서 값만 채우세요.

# DATABASE_URL — 앱이 연결할 DB 접속 문자열 (예: postgres://user:pass@host:5432/db)
DATABASE_URL=

# SECRET_KEY — 세션/토큰 서명용 비밀 키
SECRET_KEY=

# LOG_LEVEL — 로그 레벨 (예: DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# VAULT_ADDR — 시크릿 매니저 주소 (운영에서 Vault/클라우드 시크릿 매니저로 교체 시)
VAULT_ADDR=
